import sheet
s is sheet.new_sheet of null
txt is read_text of "REVIEW_DIR/api/big.csv"
sheet.from_csv of [s, txt, 0, 0]
sheet.recalc of s
print of ("C1=" + (sheet.display of [s,"C1"]) + " C2=" + (sheet.display of [s,"C2"]) + " A2=" + (sheet.display of [s,"A2"]))
sheet.set_cell of [s,"D1","=SUM(A1:B1)"]
sheet.set_cell of [s,"D2","=A1&\"\""]
sheet.recalc of s
print of ("D1=" + (sheet.display of [s,"D1"]) + " D2=" + (sheet.display of [s,"D2"]))
print of ("csv out=" + (sheet.to_csv of [s,0,0,3,1]))
