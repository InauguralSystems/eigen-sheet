import sheet
load_file of "bar_api.eigs"
s is sheet.new_sheet of null
sheet.set_cell of [s,"D1","9223372036854775807"]
sheet.set_cell of [s,"D2","9223372036854775807"]
sheet.define_name of [s,"big","D1:D2"]
sheet.define_name of [s,"bn","9223372036854775807"]
sheet.set_cell of [s,"A1","=SUM(big)"]
sheet.set_cell of [s,"A2","=bn+bn"]
sheet.set_cell of [s,"A3","=bn*2"]
sheet.set_cell of [s,"A4","=MAX(big)*2"]
sheet.set_cell of [s,"A5","=1+1"]
sheet.recalc of s
bar_stage of [s, "named", ["A1","A2","A3","A4","A5"]]
