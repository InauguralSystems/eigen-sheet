import sheet
load_file of "bar_api.eigs"
s is sheet.new_sheet of null
sheet.set_cell of [s,"K1","key"]
sheet.set_cell of [s,"L1","val"]
sheet.set_cell of [s,"K2","a"]
sheet.set_cell of [s,"L2","5000000000"]
sheet.set_cell of [s,"K3","b"]
sheet.set_cell of [s,"L3","9223372036854775807"]
sheet.set_cell of [s,"K4","b"]
sheet.set_cell of [s,"L4","1"]
sheet.recalc of s
sheet.pivot of [s,10,0,11,3,0,1,"AVERAGE",13,0]
bar_stage of [s, "pivot", ["O2","O3","O4"]]
