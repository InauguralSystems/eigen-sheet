import sheet
load_file of "bar_api.eigs"
s is sheet.new_sheet of null
txt is read_text of "big.csv"
sheet.from_csv of [s, txt, 0, 0]
sheet.set_cell of [s,"D1","=SUM(A1:B1)"]
sheet.set_cell of [s,"D2","=A1&\"\""]
sheet.recalc of s
bar_stage of [s, "read", ["A1","B1","C1","A2","B2","C2","D1","D2"]]
out is sheet.to_csv of [s,0,0,3,1]
bar_value of ["read:csv", out, out]
